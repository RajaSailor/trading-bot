# ============================================================================
# DhanHQ Trading Bot - Production Environment Configuration
# ============================================================================
# DO NOT commit actual values to GitHub!
# Copy this file to .env and fill in your actual values in Render Dashboard
# 
# To set in Render:
# 1. Go to https://dashboard.render.com
# 2. Select your service
# 3. Go to Environment tab
# 4. Add each variable below with actual values

# ============================================================================
# TELEGRAM BOT CONFIGURATION
# ============================================================================
# Get from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
WEBHOOK_SECRET=your_random_webhook_secret

# Optional: Dedicated service alerts bot
BOT_SERVICE_ALERTS_TOKEN=your_service_alerts_bot_token
CHANNEL_SERVICE_ALERTS_ID=your_service_alerts_channel_id

# Optional: Dedicated trade control bot
BOT_TRADE_CONTROL_TOKEN=your_trade_control_bot_token
CHANNEL_TRADE_CONTROL_ID=your_trade_control_channel_id

# ============================================================================
# DHAN HQ API CONFIGURATION
# ============================================================================
# Get from: https://dhan.co/ (DhanHQ Trading Account)
API_KEY=your_dhan_api_key
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_REDIRECT_URI=https://your-app-name.onrender.com/oauth/callback

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# For production, use PostgreSQL on Render
# Format: postgresql://user:password@host:port/database
TRADING_DB_PATH=/var/data/trading.db
DATABASE_POOL_SIZE=5
DATABASE_ECHO=false

# ============================================================================
# TRADING CONFIGURATION
# ============================================================================
PRACTICE_MODE=true
AUTO_TRADING_ENABLED=false
MAX_DAILY_LOSS=5000
MAX_POSITION_SIZE=100000
RISK_PER_TRADE=2

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=10000
SERVER_HOST=0.0.0.0
FLASK_ENV=production
ENVIRONMENT=production

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log
LOG_FORMAT=json

# ============================================================================
# TIMEZONE & REGIONAL SETTINGS
# ============================================================================
TIMEZONE=Asia/Kolkata
LOCALE=en_IN

# ============================================================================
# MONITORING & ALERTS
# ============================================================================
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=300
CRITICAL_ALERT_RETRY=3
WARNING_ALERT_RETRY=2

# ============================================================================
# SECURITY
# ============================================================================
DEBUG=false
SECURE_COOKIES=true
ALLOWED_HOSTS=your-app-name.onrender.com
