# DhanHQ Trading Bot - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env file to git - it contains secrets!
# ONLY .env.example (this file) should be in git
# Format: cp .env.example .env

# ============================================================================
# DHANHQ TRADING ACCOUNT
# ============================================================================
# Get these from your DhanHQ account at: https://www.dhan.co/
# Settings → API Configuration

# JWT Access Token (expires periodically, regenerate in DhanHQ dashboard)
# EXAMPLE FORMAT (replace with your actual token)
# Your Token: eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzUxMiJ9.eyJ1c2VyUmVnaW9uIjoiUjEiLCJpc3MiOiJkaGFuIiwicGFydG5lcklkIjoiIiwiZXhwIjoxNzg5NDUwMTQ1LCJpYXQiOjE3ODkzNjM3NDUsInRva2VuQ29uc3VtZXJUeXBlIjoiU0VMRiIsIndlYmhvb2tVcmwiOiIiLCJkaGFuQ2xpZW50SWQiOiIxMTExNzc4NDQyIn0.tb04Z9KFOgBJ4aUutK9lMnv2BWbzvRBb7RnVVUsIinksYG9I7vdJ_YxfHhJiwPnhfngucuHRJfYGbhKz47nkSw
ACCESS_TOKEN=your_dhanhq_jwt_token_here

# Your unique DhanHQ Client ID
# EXAMPLE: 1111778442
DHAN_CLIENT_ID=1111778442

# API Key for DhanHQ
# EXAMPLE: f6c12cb2
API_KEY=f6c12cb2

# DhanHQ PIN (for 2FA)
# EXAMPLE: 8144444 (4-8 digits)
DHAN_PIN=8144444

# TOTP Secret for 2FA (for automated login)
# EXAMPLE: APATWXGV4LDO2XBLEJQDEFTQKNSXMM3K
DHAN_TOTP_SECRET=APATWXGV4LDO2XBLEJQDEFTQKNSXMM3K

# Webhook Secret for postback verification (HMAC-SHA256)
# Use a strong random string (32+ chars)
# EXAMPLE: 7kJ9mL2pQ5xR8tV1wY3nB6cD9hF2jG5kL8mN
# Must match webhook secret in DhanHQ Settings → Webhooks
DHAN_WEBHOOK_SECRET=7kJ9mL2pQ5xR8tV1wY3nB6cD9hF2jG5kL8mN

# ============================================================================
# TELEGRAM - PRIMARY BOT TOKEN
# ============================================================================
# Create bot via @BotFather on Telegram → /newbot
# This single bot receives ALL trade signals and sends alerts to all channels

# Your Main Telegram Bot Token
# EXAMPLE: 8654404135:AAGHqdH81h1t1_RzjfqBSsbRk8O5l-ozRdc
TELEGRAM_BOT_TOKEN=8654404135:AAGHqdH81h1t1_RzjfqBSsbRk8O5l-ozRdc

# Your Chat ID (for testing/fallback)
# EXAMPLE: -1003966854994 (negative for channels/groups)
TELEGRAM_CHAT_ID=-1003966854994

# ============================================================================
# TELEGRAM - MULTI-CHANNEL SETUP (for segregated alerts)
# ============================================================================
# Each channel receives different types of alerts based on asset class
# Format: negative number (e.g., -1003704821776)

# 1. TRADE CONTROL CHANNEL
# Purpose: Trade signal reception, confirmations, position updates, SL/Target alerts, status commands
# EXAMPLE: -1003704821776
CHANNEL_TRADE_CONTROL_ID=-1003704821776

# 2. SERVICE ALERTS CHANNEL
# Purpose: System errors, deployment alerts, Render errors, Python errors, DhanHQ API errors
# EXAMPLE: -1004402571102
CHANNEL_SERVICE_ALERTS_ID=-1004402571102

# 3. COMMODITY OPTIONS CHANNEL
# Purpose: GOLD, SILVER, CRUDE OIL, NATURAL GAS - ATM CALL/PUT alerts
# Alert Format:
# GOLD | 📉 PUT ENTRY (PE Premium)
# Entry: 2998.00, Target 1: 3008.00, Target 2: 3018.00, Target 3: 3028.00, SL: 2959.50
# Strike: GOLD-25Sep2026-153000-PE, Premium: ₹2878.00
# EXAMPLE: -1004403277287
CHANNEL_COMMODITY_ID=-1004403277287

# 4. INDEX OPTIONS CHANNEL
# Purpose: NIFTY, BANKNIFTY, SENSEX - ATM CALL/PUT alerts
# Alert Format:
# Nifty | 📉 CALL ENTRY (CE Premium)
# Entry: 299.00, Target 1: 309.00, Target 2: 319.00, Target 3: 329.00, SL: 295
# Strike: NIFTY-15Sep2026-23000-CE, Premium: ₹287
# EXAMPLE: -1003966854994
CHANNEL_INDEX_ID=-1003966854994

# 5. NIFTY50 STOCK OPTIONS CHANNEL
# Purpose: NIFTY 50 stocks (50 stocks) - ATM CALL/PUT alerts
# Stocks: ADANIENTERPRISES, ADANIPORTS, APOLLOHOSP, ASIANPAINT, AXISBANK, 
#         BAJAJFINSV, BAJAJHLDNG, BAJAJ-AUTO, BHARTIARTL, BEL, BHEL, 
#         CIPLA, COALINDIA, DRREDDY, EICHERMOT, ETERNAL, GRASIM, 
#         HCLTECH, HDFCBANK, HDFCLIFE, HINDALCO, HINDUNILVR, 
#         ICICIBANK, INFY, INDIGO, ITC, JSWSTEEL, JIOFINANCIAL, 
#         KOTAKBANK, LT, M&M, MARUTI, MAXHEALTH, NTPC, NESTLEIND, 
#         ONGC, POWERGRID, RELIANCE, SBILIFE, SHRIRAMFIN, SBIN, 
#         SUNPHARMA, TCS, TATACONSUM, TATAMOTORS, TATASTEELQ, TECHM, 
#         TITAN, TRENT, ULTRACEMCO, WIPRO
# Alert Format:
# HDFC Bank | 📉 CALL ENTRY (CE Premium)
# Entry: 29.00, Target 1: 39.00, Target 2: 49.00, Target 3: 59.00, SL: 25
# Strike: HDFC Bank-30Sep2026-23000-CE, Premium: ₹28
# EXAMPLE: -1003804613787
CHANNEL_NIFTY50_OPTIONS_ID=-1003804613787

# 6. NIFTY50 INTRADAY 5X CHANNEL
# Purpose: NIFTY 50 stocks spot trading with 5x leverage
# Stocks: Same 50 as above (spot trading instead of options)
# Alert Format:
# HDFC Bank | 📉 CALL ENTRY
# Entry: 680.00, Target 1: 690.00, Target 2: 700.00, Target 3: 710.00, SL: 670
# Channel: NIFTY 50 STOCKS INTRADAY
# EXAMPLE: -1004466883026
CHANNEL_NIFTY50_5X_ID=-1004466883026

# 7. NIFTY50 PAY LATER CHANNEL
# Purpose: NIFTY 50 stocks BNPL (Buy Now Pay Later)
# Stocks: Same 50 as above (BNPL trading)
# Alert Format: Same as intraday but marked as PAY LATER
# EXAMPLE: -1003814243881
CHANNEL_NIFTY50_PAY_LATER_ID=-1003814243881

# 8. CRYPTO CHANNEL
# Purpose: BTC/USD, ETH/USD - spot alerts
# Alert Format:
# BTCUSD | 📉 CALL ENTRY
# Entry: 6800.00, Target 1: 6900.00, Target 2: 7000.00, Target 3: 7100.00, SL: 6700
# Channel: CRYPTO
# EXAMPLE: -1004482078964
CHANNEL_CRYPTO_ID=-1004482078964

# ============================================================================
# TRADING PARAMETERS
# ============================================================================

# Enable/Disable Practice Mode (Paper Trading)
# true = Paper trading (no real money, simulated only)
# false = Real trading (REAL MONEY - use only if tested!)
# ALWAYS start with true for testing!
PRACTICE_MODE=true

# Maximum loss allowed per trade (in ₹)
# If calculated risk exceeds this, trade is REJECTED
# EXAMPLE: 500 means max ₹500 loss per trade
MAX_LOSS_PER_TRADE=500

# Maximum position size (number of lots per trade)
# EXAMPLE: 5 means max 5 lots per trade
MAX_POSITION_SIZE=5

# Minimum Risk-Reward Ratio
# For every ₹1 risked, minimum target must be ₹1 gain
# EXAMPLE: 1.0 means 1:1 ratio, 2.0 means 2:1 ratio
MIN_RR_RATIO=1.0

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Flask environment
# production = No debug, production ready
# development = Debug mode, auto-reload
FLASK_ENV=production

# Port on which bot webhook runs
# Local: http://localhost:5000
# Render: https://trading-bot-0p7j.onrender.com:5000
PORT=5000

# Server host binding
# 0.0.0.0 = Listen on all interfaces (REQUIRED for Render/cloud)
# 127.0.0.1 = Listen only on localhost
SERVER_HOST=0.0.0.0

# Webhook secret (for Flask endpoint verification)
# Can be same as DHAN_WEBHOOK_SECRET
# EXAMPLE: 7kJ9mL2pQ5xR8tV1wY3nB6cD9hF2jG5kL8mN
WEBHOOK_SECRET=7kJ9mL2pQ5xR8tV1wY3nB6cD9hF2jG5kL8mN

# ============================================================================
# TIME & TIMEZONE
# ============================================================================

# Timezone for all time operations
# MUST BE: Asia/Kolkata (for Indian market)
# Do NOT change unless you know what you're doing!
TIMEZONE=Asia/Kolkata

# Market start time (24-hour format, IST)
# NSE F&O: 09:15 (9:15 AM)
# MCX: 09:00 (9:00 AM)
MARKET_START_TIME=09:00

# Market end time (24-hour format, IST)
# NSE F&O: 15:30 (3:30 PM)
# MCX: 23:30 (11:30 PM)
MARKET_END_TIME=23:30

# ============================================================================
# STATE & LOGGING
# ============================================================================

# File to persist trading state (positions, orders, history)
# Created automatically in app directory
# Survives bot restarts
STATE_FILE=dhan_state.json

# Log level
# DEBUG = Very verbose (for troubleshooting)
# INFO = Normal operation
# WARNING = Only warnings and errors
# ERROR = Only errors
LOG_LEVEL=INFO

# ============================================================================
# RENDER CLOUD DEPLOYMENT
# ============================================================================

# Render auto-redeploy trigger
RENDER_TRIGGER_REDEPLOY=false

# Auto trading enabled flag
# false = Disabled (manual alerts only)
# true = Enabled (auto-execution)
AUTO_TRADING_ENABLED=false

# ============================================================================
# IMPORTANT SECURITY NOTES
# ============================================================================
#
# 🔒 SECURITY CRITICAL:
# 1. NEVER commit .env file to git! (contains real secrets)
# 2. ONLY .env.example should be in git (template, no secrets)
# 3. Add .env to .gitignore to prevent accidental commits
# 4. In Render: Add environment variables in dashboard (not in git)
# 5. Rotate tokens regularly
# 6. Keep DHAN_WEBHOOK_SECRET private
# 7. Don't share TELEGRAM_BOT_TOKEN
#
# 📋 SETUP CHECKLIST:
# ✅ Copy this file: cp .env.example .env
# ✅ Fill in your actual DhanHQ credentials
# ✅ Generate Telegram bot via @BotFather
# ✅ Get your chat IDs (curl method shown in README)
# ✅ Whitelist server IP in DhanHQ: Settings → API → IP Whitelist
# ✅ Add webhook in DhanHQ: Settings → Webhooks
# ✅ Test connection: python -c "from dhan_api_client import ..."
# ✅ Start with PRACTICE_MODE=true
# ✅ Deploy to Render with env vars (not .env file!)
#
# 🧪 TESTING:
# python -c "from dhan_api_client import DhanAPIClient; ..."
# python -c "from telegram import Bot; import asyncio; ..."
#
# 📞 SUPPORT:
# DhanHQ: support@dhan.co
# Docs: https://github.com/Kalaiviswa/dhan-api-v2-docs
# Telegram: @BotFather for bot help
#
# ============================================================================
