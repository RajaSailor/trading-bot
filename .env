API_KEY=YOUR_DHAN_API_KEY
ACCESS_TOKEN=YOUR_DHAN_ACCESS_TOKEN

# ============================================================================
# 🔧 SYSTEM ALERTS BOT (Daily checks, errors, mobile control)
# ============================================================================
TELEGRAM_TOKEN=YOUR_TELEGRAM_TOKEN
CHAT_ID=YOUR_CHAT_ID

# ============================================================================
# 📊 TRADING BOTS - 6 CHANNELS (Multi-Bot Configuration)
# ============================================================================

# BOT 1: INDEX F&O (NIFTY, BANKNIFTY, SENSEX)
BOT_INDEX_TOKEN=YOUR_BOT_INDEX_TOKEN
CHANNEL_INDEX_ID=YOUR_CHANNEL_INDEX_ID

# BOT 2: NIFTY 50 STOCKS OPTIONS (All 50 stocks)
BOT_NIFTY50_OPTIONS_TOKEN=YOUR_BOT_NIFTY50_OPTIONS_TOKEN
CHANNEL_NIFTY50_OPTIONS_ID=YOUR_CHANNEL_NIFTY50_OPTIONS_ID

# BOT 3: COMMODITY F&O (CRUDEOIL, GOLD, SILVER, NATURALGAS)
BOT_COMMODITY_TOKEN=YOUR_BOT_COMMODITY_TOKEN
CHANNEL_COMMODITY_ID=YOUR_CHANNEL_COMMODITY_ID

# BOT 4: NIFTY 50 INTRADAY 5X (All 50 stocks - Spot, 5X margin)
BOT_NIFTY50_5X_TOKEN=YOUR_BOT_NIFTY50_5X_TOKEN
CHANNEL_NIFTY50_5X_ID=YOUR_CHANNEL_NIFTY50_5X_ID

# BOT 5: NIFTY 50 PAY LATER (All 50 stocks - Margin/BNPL)
BOT_NIFTY50_PAY_LATER_TOKEN=YOUR_BOT_NIFTY50_PAY_LATER_TOKEN
CHANNEL_NIFTY50_PAY_LATER_ID=YOUR_CHANNEL_NIFTY50_PAY_LATER_ID

# BOT 6: CRYPTO (BTCUSD, ETHUSD - TradingView)
BOT_CRYPTO_TOKEN=YOUR_BOT_CRYPTO_TOKEN
CHANNEL_CRYPTO_ID=YOUR_CHANNEL_CRYPTO_ID

# ============================================================================
# 🌍 MARKET CONFIGURATION
# ============================================================================
MARKET_TIMEZONE=Asia/Kolkata
NSE_MARKET_OPEN=09:15
NSE_MARKET_CLOSE=15:30
MCX_MARKET_OPEN=09:00
MCX_MARKET_CLOSE=23:30
SCAN_INTERVAL=5

# ============================================================================
# 🚀 PROJECT CONFIGURATION
# ============================================================================
PROJECT_NAME=trading-bot-suite-multi-channel
PROJECT_VERSION=2.0.0
PROJECT_ENV=production
DEPLOYMENT_PLATFORM=render
STRATEGY=10-MINUTE-BREAKOUT

