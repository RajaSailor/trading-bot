# DhanHQ Trading Bot - Production Environment Template
# NOTE: Fill these values in your private deployment environment.

# Flask / runtime
FLASK_ENV=production
PORT=5000
SERVER_HOST=0.0.0.0
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# DhanHQ credentials (set securely in deployment platform)
ACCESS_TOKEN=
DHAN_CLIENT_ID=
API_KEY=
DHAN_PIN=
DHAN_TOTP_SECRET=
DHAN_WEBHOOK_SECRET=

# Telegram credentials
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CHANNEL_SERVICE_ALERTS_ID=
CHANNEL_TRADE_CONTROL_ID=

# Database/cache
POSTGRES_DB=trading_bot
POSTGRES_USER=trading_bot
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://trading_bot:change_me@postgres:5432/trading_bot
REDIS_URL=redis://redis:6379/0

# Trading behavior
PRACTICE_MODE=false
AUTO_TRADING_ENABLED=false
MAX_LOSS_PER_TRADE=500
MAX_POSITION_SIZE=5
