# DhanHQ Trading Bot - Development Environment

# Flask / runtime
FLASK_ENV=development
PORT=5000
SERVER_HOST=0.0.0.0
LOG_LEVEL=DEBUG
TIMEZONE=Asia/Kolkata

# Local development/test values
ACCESS_TOKEN=test_access_token
DHAN_CLIENT_ID=test_client_id
API_KEY=test_api_key
DHAN_PIN=0000
DHAN_TOTP_SECRET=test_totp_secret
DHAN_WEBHOOK_SECRET=dev_webhook_secret

# Telegram development placeholders
TELEGRAM_BOT_TOKEN=test_telegram_bot_token
TELEGRAM_CHAT_ID=123456789
CHANNEL_SERVICE_ALERTS_ID=123456789
CHANNEL_TRADE_CONTROL_ID=123456789

# Database/cache
POSTGRES_DB=trading_bot_dev
POSTGRES_USER=trading_bot
POSTGRES_PASSWORD=trading_bot
DATABASE_URL=postgresql://trading_bot:trading_bot@postgres:5432/trading_bot_dev
REDIS_URL=

# Trading behavior
PRACTICE_MODE=true
AUTO_TRADING_ENABLED=false
MAX_LOSS_PER_TRADE=500
MAX_POSITION_SIZE=2
